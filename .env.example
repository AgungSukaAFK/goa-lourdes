# GOA HZ — environment
# Semua nilai ada di Supabase Dashboard → Project Settings.

# ── Supabase (wajib) ─────────────────────────────────────────────
# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# atau "anon public" key (eyJ...) kalau masih pakai legacy key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=

# Project Settings → API Keys → "Secret key" (sb_secret_...) / "service_role"
# RAHASIA: hanya dipakai di server (buat akun user, import karyawan, migrasi data lama).
# Jangan pernah pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase CLI (untuk menjalankan migration SQL dari repo) ─────
# Reference ID di Project Settings → General (bagian xxxxx dari URL di atas)
SUPABASE_PROJECT_REF=
# Project Settings → Database → Connection string → URI (pakai password DB)
SUPABASE_DB_URL=

# ── App ──────────────────────────────────────────────────────────
# URL tempat app di-deploy (dipakai untuk link di email reset password, QR aset, dll)
NEXT_PUBLIC_APP_URL=http://localhost:3000
